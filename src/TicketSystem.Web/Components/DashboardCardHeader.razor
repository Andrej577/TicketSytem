<MudStack Row="true" Justify="Justify.SpaceBetween">
    <MudStack Spacing="0">
        <MudText Typo="@Typo">@Title</MudText>
    </MudStack>
</MudStack>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public Typo Typo { get; set; } = Typo.subtitle2;
}

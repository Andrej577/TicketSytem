@using System.Globalization
@using System.Text.Json
@inject IDialogService DialogService
@inject TicketSystemApiClient ApiClient
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField T="string" Label="Title" @bind-Value="_editedTicket.Title" ReadOnly="_isReadOnly" Variant="Variant.Outlined" />

            <MudGrid Spacing="2">
                <MudItem xs="6">
                    <MudTextField T="string" Label="Sender email" Value="@_editedTicket.CustomerEmail" ReadOnly="true" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="6">
                    @if (_canAssign)
                    {
                        <MudSelect T="Guid?" Label="Assigned to" @bind-Value="_editedTicket.OperatorId" Variant="Variant.Outlined" Disabled="_isLoadingOperators">
                            <MudSelectItem T="Guid?" Value="@((Guid?)null)">Unassigned</MudSelectItem>
                            @foreach (var appOperator in _operators)
                            {
                                <MudSelectItem T="Guid?" Value="@((Guid?)appOperator.Id)">@appOperator.Email</MudSelectItem>
                            }
                        </MudSelect>
                    }
                    else
                    {
                        <MudTextField T="string" Label="Assigned to" Value="@(_editedTicket.OperatorEmail ?? "Unassigned")" ReadOnly="true" Variant="Variant.Outlined" />
                    }
                </MudItem>
                <MudItem xs="12">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.body2">Priority</MudText>
                        <MudToggleGroup T="short" @bind-Value="_editedTicket.PriorityId" Vertical="false" Color="@GetPriorityColor()" Disabled="@(_isReadOnly || _isLoadingPriorities || _priorities.Count == 0)" Class="mud-width-full">
                            @foreach (var priority in _priorities)
                            {
                                <MudToggleItem T="short" Value="@priority.Id" Text="@priority.DisplayName" />
                            }
                        </MudToggleGroup>
                    </MudStack>
                </MudItem>
                <MudItem xs="12">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.body2">Status</MudText>
                        <MudToggleGroup T="short" @bind-Value="_editedTicket.StatusId" Vertical="false" Color="@GetStatusColor()" Disabled="_isReadOnly" Class="mud-width-full">
                            @foreach (var status in TicketStatusOptions.All)
                            {
                                <MudToggleItem T="short" Value="@status.Id" Text="@status.Name" />
                            }
                        </MudToggleGroup>
                    </MudStack>
                </MudItem>
            </MudGrid>

            @if (_isLoadingPriorities || _isLoadingOperators)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
            }

            <MudTextField T="string" Label="Content" @bind-Value="_editedTicket.Content" ReadOnly="_isReadOnly" Lines="6" Variant="Variant.Outlined" />

            <MudStack Spacing="0">
                <MudText Typo="Typo.caption">Created @_editedTicket.CreatedAt.ToString("dd MMM yyyy, HH:mm", CultureInfo.InvariantCulture)</MudText>
                <MudText Typo="Typo.caption">Updated @_editedTicket.UpdatedAt.ToString("dd MMM yyyy, HH:mm", CultureInfo.InvariantCulture)</MudText>
            </MudStack>
        </MudStack>
    </DialogContent>

    <DialogActions>
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="px-4 mud-width-full">
            @if (_canDelete)
            {
                <MudButton Color="Color.Error" Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.Delete" OnClick="DeleteAsync" Disabled="@(_isSaving || _isDeleting)">Delete</MudButton>
            }
            <MudSpacer />
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.Chat" Disabled="true">Open chat</MudButton>
            <MudButton Variant="Variant.Text" OnClick="Cancel" Disabled="@(_isSaving || _isDeleting)">@(_isReadOnly ? "Close" : "Cancel")</MudButton>
            @if (!_isReadOnly)
            {
                <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Outlined.Save" OnClick="SaveAsync" Disabled="@(_isLoadingPriorities || _isLoadingOperators || _priorities.Count == 0 || _isSaving || _isDeleting)">Save</MudButton>
            }
        </MudStack>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance _dialogInstance { get; set; } = null!;

    [Parameter]
    public TicketPOCO _ticket { get; set; } = null!;

    [Parameter]
    public bool _isReadOnly { get; set; }

    [Parameter]
    public bool _canAssign { get; set; }

    [Parameter]
    public bool _canDelete { get; set; }

    private TicketPOCO _editedTicket = new();
    private List<AppUserDTO> _operators = [];
    private List<TicketPriorityDTO> _priorities = [];
    private bool _isDeleting;
    private bool _isLoadingOperators;
    private bool _isLoadingPriorities = true;
    private bool _isSaving;

    protected override async Task OnInitializedAsync()
    {
        _editedTicket = _ticket.Copy();
        await LoadPrioritiesAsync();

        if (_canAssign)
        {
            await LoadOperatorsAsync();
        }
    }

    private async Task LoadPrioritiesAsync()
    {
        try
        {
            using var response = await ApiClient.GetAsync("api/ticket-priorities");

            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add("Ticket priorities could not be loaded.", Severity.Error);
                return;
            }

            _priorities = await response.Content.ReadFromJsonAsync<List<TicketPriorityDTO>>() ?? [];
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("The API is currently unavailable.", Severity.Error);
        }
        catch (JsonException)
        {
            Snackbar.Add("The API returned an invalid priority response.", Severity.Error);
        }
        catch (TaskCanceledException)
        {
            Snackbar.Add("The priority request timed out.", Severity.Error);
        }
        finally
        {
            _isLoadingPriorities = false;
        }
    }

    private async Task LoadOperatorsAsync()
    {
        _isLoadingOperators = true;

        try
        {
            using var response = await ApiClient.GetAsync("api/app-users");

            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add("Support users could not be loaded.", Severity.Error);
                return;
            }

            var users = await response.Content.ReadFromJsonAsync<List<AppUserDTO>>() ?? [];
            _operators = users.Where(user => user.UserTypeId == (int)AppUserType.Operator).ToList();
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("The API is currently unavailable.", Severity.Error);
        }
        catch (JsonException)
        {
            Snackbar.Add("The API returned an invalid users response.", Severity.Error);
        }
        catch (TaskCanceledException)
        {
            Snackbar.Add("The users request timed out.", Severity.Error);
        }
        finally
        {
            _isLoadingOperators = false;
        }
    }

    private async Task SaveAsync()
    {
        _isSaving = true;

        try
        {
            _editedTicket.ClosedAt = _editedTicket.StatusId == TicketStatusOptions.ClosedId ? _editedTicket.ClosedAt ?? DateTimeOffset.Now : null;

            using var response = await ApiClient.PutAsJsonAsync($"api/tickets/{_editedTicket.Id}", _editedTicket);

            if (!response.IsSuccessStatusCode || !await response.Content.ReadFromJsonAsync<bool>())
            {
                Snackbar.Add("Ticket could not be updated.", Severity.Error);
                return;
            }

            var priority = _priorities.Single(priority => priority.Id == _editedTicket.PriorityId);
            _editedTicket.PriorityDisplayName = priority.DisplayName;
            _editedTicket.PriorityImpact = priority.Impact;
            _editedTicket.UpdatedAt = DateTimeOffset.Now;

            if (_canAssign)
            {
                _editedTicket.OperatorEmail = _editedTicket.OperatorId.HasValue
                    ? _operators.Single(appOperator => appOperator.Id == _editedTicket.OperatorId.Value).Email
                    : null;
            }

            _dialogInstance.Close(DialogResult.Ok(_editedTicket));
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("The API is currently unavailable.", Severity.Error);
        }
        catch (JsonException)
        {
            Snackbar.Add("The API returned an invalid ticket response.", Severity.Error);
        }
        catch (TaskCanceledException)
        {
            Snackbar.Add("The ticket update timed out.", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task DeleteAsync()
    {
        var confirmed = await DialogService.ShowMessageBoxAsync("Delete ticket", $"Delete ticket #{_editedTicket.TicketNumber}?", yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        _isDeleting = true;

        try
        {
            using var response = await ApiClient.DeleteAsync($"api/tickets/{_editedTicket.Id}");

            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add("Ticket could not be deleted.", Severity.Error);
                return;
            }

            _dialogInstance.Close(DialogResult.Ok(_editedTicket.Id));
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("The API is currently unavailable.", Severity.Error);
        }
        catch (TaskCanceledException)
        {
            Snackbar.Add("The ticket delete request timed out.", Severity.Error);
        }
        finally
        {
            _isDeleting = false;
        }
    }

    private Color GetPriorityColor()
    {
        var priority = _priorities.FirstOrDefault(priority => priority.Id == _editedTicket.PriorityId);
        return TicketPriorityColorMapper.GetColor(priority?.Impact ?? _editedTicket.PriorityImpact);
    }

    private Color GetStatusColor()
    {
        return TicketStatusOptions.All.Single(status => status.Id == _editedTicket.StatusId).Color;
    }

    private void Cancel()
    {
        _dialogInstance.Cancel();
    }
}

@implements IAsyncDisposable
@using System.Globalization
@using System.Text.Json
@using Microsoft.AspNetCore.SignalR.Client
@using TicketSystem.Shared.Realtime
@inject IConfiguration Configuration
@inject IDialogService DialogService
@inject TicketSystemApiClient ApiClient
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Ticket #@_editedTicket.TicketNumber</MudText>
    </TitleContent>
    <DialogContent>
        <div class="ticket-tabs-header">
        <MudTabs KeepPanelsAlive="true" Rounded="true" ApplyEffectsToContainer="true" ActivePanelIndexChanged="HandleActivePanelIndexChangedAsync">
            <MudTabPanel Text="Details" Icon="@Icons.Material.Outlined.Info">
                <div class="ticket-details-tab">
                    <MudStack Spacing="3">
                        <MudTextField T="string" Label="Title" @bind-Value="_editedTicket.Title" @bind-Value:after="AutoSaveAsync" ReadOnly="_isReadOnly" Variant="Variant.Outlined" />

                        <MudGrid Spacing="2">
                            <MudItem xs="6">
                                <MudTextField T="string" Label="Customer" Value="@_editedTicket.CustomerName" ReadOnly="true" Variant="Variant.Outlined" />
                            </MudItem>
                            <MudItem xs="6">
                                @if (_canAssign)
                                {
                                    <MudSelect T="Guid?" Label="Assigned to" @bind-Value="_editedTicket.OperatorId" @bind-Value:after="AutoSaveAsync" Variant="Variant.Outlined" Disabled="_isLoadingOperators">
                                        <MudSelectItem T="Guid?" Value="@((Guid?)null)">Unassigned</MudSelectItem>
                                        @foreach (var appOperator in _operators)
                                        {
                                            <MudSelectItem T="Guid?" Value="@((Guid?)appOperator.Id)">@($"{appOperator.FirstName} {appOperator.LastName}")</MudSelectItem>
                                        }
                                    </MudSelect>
                                }
                                else
                                {
                                    <MudTextField T="string" Label="Assigned to" Value="@(_editedTicket.OperatorName ?? "Unassigned")" ReadOnly="true" Variant="Variant.Outlined" />
                                }
                            </MudItem>
                            <MudItem xs="12">
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.body2">Priority</MudText>
                                    <MudToggleGroup T="short" @bind-Value="_editedTicket.PriorityId" @bind-Value:after="AutoSaveAsync" Vertical="false" Color="@GetPriorityColor()" Disabled="@(_isReadOnly || _isLoadingPriorities || _priorities.Count == 0)" Class="mud-width-full">
                                        @foreach (var priority in _priorities)
                                        {
                                            <MudToggleItem T="short" Value="@priority.Id" Text="@priority.DisplayName" />
                                        }
                                    </MudToggleGroup>
                                </MudStack>
                            </MudItem>
                            <MudItem xs="12">
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.body2">Status</MudText>
                                    <MudToggleGroup T="short" @bind-Value="_editedTicket.StatusId" @bind-Value:after="AutoSaveAsync" Vertical="false" Color="@GetStatusColor()" Disabled="_isReadOnly" Class="mud-width-full">
                                        @foreach (var status in TicketStatusOptions.All)
                                        {
                                            <MudToggleItem T="short" Value="@status.Id" Text="@status.Name" />
                                        }
                                    </MudToggleGroup>
                                </MudStack>
                            </MudItem>
                        </MudGrid>

                        @if (_isLoadingPriorities || _isLoadingOperators)
                        {
                            <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
                        }

                        <MudTextField T="string" Label="Content" @bind-Value="_editedTicket.Content" @bind-Value:after="AutoSaveAsync" ReadOnly="_isReadOnly" Lines="6" Variant="Variant.Outlined" />

                        <MudDivider />
                        <MudGrid Spacing="2">
                            <MudItem xs="6">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Created</MudText>
                                <MudText Typo="Typo.body2">@_editedTicket.CreatedAt.ToString("dd MMM yyyy, HH:mm", CultureInfo.InvariantCulture)</MudText>
                            </MudItem>
                            <MudItem xs="6">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Updated</MudText>
                                <MudText Typo="Typo.body2">@_editedTicket.UpdatedAt.ToString("dd MMM yyyy, HH:mm", CultureInfo.InvariantCulture)</MudText>
                            </MudItem>
                        </MudGrid>
                    </MudStack>
                </div>
            </MudTabPanel>

            <MudTabPanel Text="Conversation" Icon="@Icons.Material.Outlined.Chat">
                <MudFileUpload T="IBrowserFile" Accept="@AllowedMediaExtensions" FilesChanged="AddPendingFile" MaximumFileCount="1" MaxFileSize="@MaximumMediaFileSize" Disabled="@(_isChatClosed || _isSendingMessage)" DragAndDrop="true" @bind-Dragging="_isDraggingFile" Class="ticket-chat-drop-upload">
                    <CustomContent Context="dropUpload">
                        <div class="@($"ticket-chat-tab{(_isDraggingFile ? " ticket-chat-drop-active" : string.Empty)}")" @ondragenter="StartFileDragging">
                            @if (_isLoadingMessages)
                            {
                                <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="ticket-chat-scroll">
                                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                                </MudStack>
                            }
                            else
                            {
                                <div class="ticket-chat-scroll" @ref="_chatScrollElement">
                                    @if (ChatTimeline.Count == 0)
                                    {
                                        <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="mud-height-full">
                                            <MudIcon Icon="@Icons.Material.Outlined.Forum" Color="Color.Secondary" Size="Size.Large" />
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">No messages</MudText>
                                        </MudStack>
                                    }
                                    else
                                    {
                                        <MudStack Spacing="2">
                                            @foreach (var entry in ChatTimeline)
                                            {
                                                @if (entry.Message is not null)
                                                {
                                                    <MudPaper Outlined="true" Class="pa-3">
                                                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
                                                            <MudText Typo="Typo.subtitle2" Color="@GetSenderColor(entry.Message.SenderId)">@GetMessageSenderName(entry.Message)</MudText>
                                                            <MudText Typo="Typo.caption">@entry.Message.SentAt.ToString("dd MMM yyyy, HH:mm", CultureInfo.InvariantCulture)</MudText>
                                                        </MudStack>
                                                        <MudText Typo="Typo.body2" Class="ticket-message-content">@entry.Message.Content</MudText>
                                                    </MudPaper>
                                                }
                                                else if (entry.MediaFile is not null)
                                                {
                                                    <MudPaper Outlined="true" Class="pa-3">
                                                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
                                                            <MudText Typo="Typo.subtitle2" Color="@GetSenderColor(entry.MediaFile.UploadedByUserId)">@GetMediaUploaderName(entry.MediaFile)</MudText>
                                                            <MudText Typo="Typo.caption">@entry.MediaFile.CreatedAt.ToString("dd MMM yyyy, HH:mm", CultureInfo.InvariantCulture)</MudText>
                                                        </MudStack>
                                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-1">
                                                            <MudIcon Icon="@Icons.Material.Outlined.Description" Color="Color.Primary" />
                                                            <MudText Typo="Typo.body2" Class="flex-grow-1">@GetMediaFileName(entry.MediaFile)</MudText>
                                                            <MudIconButton Icon="@Icons.Material.Outlined.Download" Color="Color.Primary" Href="@GetMediaDownloadUrl(entry.MediaFile)" aria-label="Download file" />
                                                        </MudStack>
                                                    </MudPaper>
                                                }
                                            }
                                        </MudStack>
                                    }
                                </div>
                            }

                            @if (_isChatClosed)
                            {
                                <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true">Reopen the ticket to continue the conversation.</MudAlert>
                            }

                            @if (_pendingFiles.Count > 0)
                            {
                                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" Class="px-3 pt-2">
                                    @foreach (var pendingFile in _pendingFiles)
                                    {
                                        <MudPaper Outlined="true" Class="pa-3 ticket-pending-file-card">
                                            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Class="ticket-pending-file-close" OnClick="@(() => RemovePendingFile(pendingFile))" Disabled="@_isSendingMessage" aria-label="Remove file" />
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                                <MudIcon Icon="@Icons.Material.Outlined.InsertDriveFile" Color="Color.Primary" Size="Size.Large" />
                                                <MudStack Spacing="0">
                                                    <MudText Typo="Typo.body2" Class="ticket-pending-file-name">@pendingFile.Name</MudText>
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@GetPendingFileTypeLabel(pendingFile) · @FormatFileSize(pendingFile.Size)</MudText>
                                                </MudStack>
                                            </MudStack>
                                        </MudPaper>
                                    }
                                </MudStack>
                            }
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="pa-3">
                                <MudMenu Dense="true" AnchorOrigin="Origin.TopLeft" TransformOrigin="Origin.BottomLeft">
                                    <ActivatorContent>
                                        <MudTooltip Text="Dodaj privitak">
                                            <MudFab Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="@context.ToggleAsync" Disabled="@(_isChatClosed || _isSendingMessage)" aria-label="Dodaj privitak" />
                                        </MudTooltip>
                                    </ActivatorContent>
                                    <ChildContent>
                                        <MudFileUpload T="IBrowserFile" Accept=".png,.jpg,.jpeg" FilesChanged="AddPendingFile" MaximumFileCount="1" MaxFileSize="@MaximumMediaFileSize" Disabled="@(_isChatClosed || _isSendingMessage)" capture="environment">
                                            <CustomContent Context="cameraUpload">
                                                <MudMenuItem Icon="@Icons.Material.Outlined.PhotoCamera" OnClick="@cameraUpload.OpenFilePickerAsync" Disabled="@(_isChatClosed || _isSendingMessage)">Kamera</MudMenuItem>
                                            </CustomContent>
                                            <SelectedTemplate></SelectedTemplate>
                                        </MudFileUpload>
                                        <MudFileUpload T="IBrowserFile" Accept="@AllowedMediaExtensions" FilesChanged="AddPendingFile" MaximumFileCount="1" MaxFileSize="@MaximumMediaFileSize" Disabled="@(_isChatClosed || _isSendingMessage)">
                                            <CustomContent Context="deviceUpload">
                                                <MudMenuItem Icon="@AppIcons.Actions.Attachment" OnClick="@deviceUpload.OpenFilePickerAsync" Disabled="@(_isChatClosed || _isSendingMessage)">Datoteka s uređaja</MudMenuItem>
                                            </CustomContent>
                                            <SelectedTemplate></SelectedTemplate>
                                        </MudFileUpload>
                                    </ChildContent>
                                </MudMenu>
                                <MudTextField @ref="_messageTextField" T="string" Label="Message" @bind-Value="_newMessage" Immediate="true" OnKeyDown="HandleMessageKeyDownAsync" Variant="Variant.Outlined" Lines="1" Sizing="InputSizing.Auto" Disabled="_isChatClosed" Class="flex-grow-1" />
                                <MudTooltip Text="Pošalji poruku">
                                    <MudFab Color="Color.Primary" Size="Size.Small" StartIcon="@AppIcons.Actions.Send" OnClick="SendMessageAsync" Disabled="@(_isChatClosed || _isSendingMessage || (string.IsNullOrWhiteSpace(_newMessage) && _pendingFiles.Count == 0))" aria-label="Pošalji poruku" />
                                </MudTooltip>
                            </MudStack>

                            @if (_isDraggingFile)
                            {
                                <div class="ticket-chat-drop-overlay">
                                    <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Color="Color.Primary" Size="Size.Large" />
                                    <MudText Typo="Typo.h6" Color="Color.Primary">Drop file to upload</MudText>
                                </div>
                            }
                        </div>
                    </CustomContent>
                    <SelectedTemplate></SelectedTemplate>
                </MudFileUpload>
            </MudTabPanel>

            <MudTabPanel Text="Media files" Icon="@AppIcons.Actions.Attachment">
                <div class="ticket-chat-tab">
                    @if (_isLoadingMediaFiles)
                    {
                        <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="ticket-chat-scroll">
                            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                        </MudStack>
                    }
                    else
                    {
                        <div class="ticket-chat-scroll pa-3">
                            @if (_mediaFiles.Count == 0)
                            {
                                <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="mud-height-full">
                                    <MudIcon Icon="@Icons.Material.Outlined.FolderOpen" Color="Color.Secondary" Size="Size.Large" />
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">No media files</MudText>
                                </MudStack>
                            }
                            else
                            {
                                <MudStack Spacing="2">
                                    @foreach (var mediaFile in _mediaFiles)
                                    {
                                        <MudPaper Outlined="true" Class="pa-3">
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                                <MudIcon Icon="@Icons.Material.Outlined.Description" Color="Color.Primary" />
                                                <MudStack Spacing="0" Class="flex-grow-1">
                                                    <MudText Typo="Typo.subtitle2">@GetMediaFileName(mediaFile)</MudText>
                                                    <MudText Typo="Typo.caption">@GetMediaUploaderName(mediaFile) · @FormatFileSize(mediaFile.SizeBytes) · @mediaFile.CreatedAt.ToString("dd MMM yyyy, HH:mm", CultureInfo.InvariantCulture)</MudText>
                                                </MudStack>
                                                <MudIconButton Icon="@Icons.Material.Outlined.Download" Color="Color.Primary" Href="@GetMediaDownloadUrl(mediaFile)" aria-label="Download file" />
                                            </MudStack>
                                        </MudPaper>
                                    }
                                </MudStack>
                            }
                        </div>
                    }
                </div>
            </MudTabPanel>
        </MudTabs>
        @if (_canDelete)
        {
            <MudButton Color="Color.Error" Variant="Variant.Text" StartIcon="@AppIcons.Actions.Delete" OnClick="DeleteAsync" Disabled="@(_isSaving || _isDeleting)" Class="ticket-delete-button">Delete</MudButton>
        }
        </div>
    </DialogContent>
</MudDialog>

<style>
    .ticket-tabs-header {
        position: relative;
    }

    .ticket-delete-button {
        padding-bottom: 8px;
        position: absolute;
        right: 0;
        top: 6px;
    }

    .ticket-details-tab {
        height: 640px;
        overflow-x: hidden;
        overflow-y: auto;
        padding: 12px;
    }

    .ticket-chat-tab {
        display: flex;
        flex-direction: column;
        height: 640px;
        min-height: 0;
        position: relative;
    }

    .ticket-chat-drop-upload,
    .ticket-chat-drop-upload.mud-file-upload-dragarea,
    .ticket-chat-drop-upload .mud-file-upload-dragarea {
        display: block;
        height: 100%;
        width: 100%;
    }

    .ticket-chat-drop-active {
        box-shadow: inset 0 0 0 2px var(--mud-palette-primary);
    }

    .ticket-chat-drop-overlay {
        align-items: center;
        background-color: var(--mud-palette-surface);
        display: flex;
        flex-direction: column;
        gap: 8px;
        inset: 0;
        justify-content: center;
        opacity: 0.95;
        pointer-events: none;
        position: absolute;
        z-index: 2;
    }

    .ticket-chat-scroll {
        flex: 1 1 auto;
        min-height: 0;
        overflow-x: hidden;
        overflow-y: auto;
        padding: 12px;
    }

    .ticket-message-content {
        overflow-wrap: anywhere;
        white-space: pre-wrap;
    }

    .ticket-pending-file-card {
        min-width: 220px;
        position: relative;
    }

    .ticket-pending-file-close {
        position: absolute;
        right: 4px;
        top: 4px;
    }

    .ticket-pending-file-name {
        font-weight: 600;
        overflow-wrap: anywhere;
    }
</style>

@code {
    private const long MaximumMediaFileSize = 10 * 1024 * 1024;
    private const string AllowedMediaExtensions = ".pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg";

    private static readonly HashSet<string> AllowedMediaExtensionSet = new(StringComparer.OrdinalIgnoreCase)
    {
        ".pdf",
        ".doc",
        ".docx",
        ".xls",
        ".xlsx",
        ".png",
        ".jpg",
        ".jpeg"
    };

    [CascadingParameter]
    private IMudDialogInstance _dialogInstance { get; set; } = null!;

    [Parameter]
    public TicketPOCO _ticket { get; set; } = null!;

    [Parameter]
    public bool _isReadOnly { get; set; }

    [Parameter]
    public bool _canAssign { get; set; }

    [Parameter]
    public bool _canDelete { get; set; }

    [Parameter]
    public bool _isOperator { get; set; }

    [Parameter]
    public Guid _currentUserId { get; set; }

    [Parameter]
    public string _currentUserEmail { get; set; } = string.Empty;

    [Parameter]
    public string _currentUserFirstName { get; set; } = string.Empty;

    [Parameter]
    public string _currentUserLastName { get; set; } = string.Empty;

    [Parameter]
    public string _accessToken { get; set; } = string.Empty;

    private TicketPOCO _editedTicket = new();
    private List<AppUserDTO> _operators = [];
    private List<TicketPriorityDTO> _priorities = [];
    private List<MessagePOCO> _messages = [];
    private List<MediaFilePOCO> _mediaFiles = [];
    private List<IBrowserFile> _pendingFiles = [];
    private HubConnection? _chatHubConnection;
    private IDisposable? _chatChangedSubscription;
    private string _newMessage = string.Empty;
    private MudTextField<string>? _messageTextField;
    private ElementReference _chatScrollElement;
    private const int ConversationPanelIndex = 1;
    private bool _shouldFocusMessageField;
    private bool _assignToCurrentUser;
    private bool _assignmentPromptHandled;
    private bool _isDeleting;
    private bool _isLoadingMediaFiles = true;
    private bool _isLoadingMessages = true;
    private bool _isLoadingOperators;
    private bool _isLoadingPriorities = true;
    private bool _isSaving;
    private bool _isSendingMessage;
    private bool _isDraggingFile;

    private bool _isChatClosed => _editedTicket.StatusId == TicketStatusOptions.ClosedId;

    private IReadOnlyList<ChatTimelineEntry> ChatTimeline => _messages
        .Select(message => new ChatTimelineEntry(message.SentAt, message, null))
        .Concat(_mediaFiles.Select(mediaFile => new ChatTimelineEntry(mediaFile.CreatedAt, null, mediaFile)))
        .OrderBy(entry => entry.Timestamp)
        .ToList();

    private sealed record ChatTimelineEntry(DateTimeOffset Timestamp, MessagePOCO? Message, MediaFilePOCO? MediaFile);

    private void StartFileDragging()
    {
        if (!_isChatClosed && !_isSendingMessage)
        {
            _isDraggingFile = true;
        }
    }

    private async Task HandleActivePanelIndexChangedAsync(int index)
    {
        if (index != ConversationPanelIndex)
        {
            return;
        }

        try
        {
            await JSRuntime.InvokeVoidAsync("scrollElementToBottom", _chatScrollElement);
        }
        catch (JSException)
        {
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _editedTicket = _ticket.Copy();
        var tasks = new List<Task>
        {
            LoadPrioritiesAsync(),
            LoadMessagesAsync(),
            LoadMediaFilesAsync(),
            ConnectToChatHubAsync()
        };

        if (_canAssign)
        {
            tasks.Add(LoadOperatorsAsync());
        }

        await Task.WhenAll(tasks);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shouldFocusMessageField && _messageTextField is not null)
        {
            _shouldFocusMessageField = false;
            await _messageTextField.FocusAsync();
        }
    }

    private async Task LoadPrioritiesAsync()
    {
        try
        {
            using var response = await ApiClient.GetAsync("api/ticket-priorities");

            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add("Ticket priorities could not be loaded.", Severity.Error);
                return;
            }

            _priorities = await response.Content.ReadFromJsonAsync<List<TicketPriorityDTO>>() ?? [];
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("The API is currently unavailable.", Severity.Error);
        }
        catch (JsonException)
        {
            Snackbar.Add("The API returned an invalid priority response.", Severity.Error);
        }
        catch (TaskCanceledException)
        {
            Snackbar.Add("The priority request timed out.", Severity.Error);
        }
        finally
        {
            _isLoadingPriorities = false;
        }
    }

    private async Task LoadOperatorsAsync()
    {
        _isLoadingOperators = true;

        try
        {
            using var response = await ApiClient.GetAsync("api/app-users");

            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add("Support users could not be loaded.", Severity.Error);
                return;
            }

            var users = await response.Content.ReadFromJsonAsync<List<AppUserDTO>>() ?? [];
            _operators = users.Where(user => user.UserTypeId == (int)AppUserType.Operator).ToList();
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("The API is currently unavailable.", Severity.Error);
        }
        catch (JsonException)
        {
            Snackbar.Add("The API returned an invalid users response.", Severity.Error);
        }
        catch (TaskCanceledException)
        {
            Snackbar.Add("The users request timed out.", Severity.Error);
        }
        finally
        {
            _isLoadingOperators = false;
        }
    }

    private async Task LoadMessagesAsync()
    {
        _isLoadingMessages = true;

        try
        {
            using var response = await ApiClient.GetAsync($"api/tickets/{_editedTicket.Id}/chat/messages");
            response.EnsureSuccessStatusCode();
            _messages = (await response.Content.ReadFromJsonAsync<List<MessagePOCO>>() ?? [])
                .OrderBy(message => message.SentAt)
                .ToList();
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or TaskCanceledException)
        {
            Snackbar.Add("Chat messages could not be loaded.", Severity.Warning);
        }
        finally
        {
            _isLoadingMessages = false;
        }
    }

    private async Task LoadMediaFilesAsync()
    {
        _isLoadingMediaFiles = true;

        try
        {
            using var response = await ApiClient.GetAsync($"api/tickets/{_editedTicket.Id}/chat/media");
            response.EnsureSuccessStatusCode();
            _mediaFiles = (await response.Content.ReadFromJsonAsync<List<MediaFilePOCO>>() ?? [])
                .OrderByDescending(mediaFile => mediaFile.CreatedAt)
                .ToList();
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or TaskCanceledException)
        {
            Snackbar.Add("Media files could not be loaded.", Severity.Warning);
        }
        finally
        {
            _isLoadingMediaFiles = false;
        }
    }

    private async Task ConnectToChatHubAsync()
    {
        var realtimeBaseUrl = Configuration["Realtime:BaseUrl"]
            ?? throw new InvalidOperationException("The 'Realtime:BaseUrl' configuration value is required.");

        _chatHubConnection = new HubConnectionBuilder()
            .WithUrl($"{realtimeBaseUrl.TrimEnd('/')}{RealtimeHubRoutes.Chat}", options =>
            {
                options.AccessTokenProvider = () => Task.FromResult<string?>(_accessToken);
            })
            .WithAutomaticReconnect()
            .Build();
        _chatChangedSubscription = _chatHubConnection.On<Guid, Guid>(ChatRealtimeEvents.Changed, HandleChatChangedAsync);
        _chatHubConnection.Reconnected += HandleChatHubReconnectedAsync;

        for (var attempt = 1; attempt <= 3; attempt++)
        {
            try
            {
                await _chatHubConnection.StartAsync();
                return;
            }
            catch (Exception exception) when (exception is HttpRequestException or InvalidOperationException or TaskCanceledException)
            {
                if (attempt == 3)
                {
                    Snackbar.Add("Live chat updates are currently unavailable.", Severity.Warning);
                    return;
                }

                await Task.Delay(TimeSpan.FromSeconds(1));
            }
        }
    }

    private async Task HandleChatChangedAsync(Guid ticketId, Guid chatSessionId)
    {
        if (ticketId != _editedTicket.Id)
        {
            return;
        }

        await InvokeAsync(async () =>
        {
            _editedTicket.ChatSessionId = chatSessionId;
            await Task.WhenAll(LoadMessagesAsync(), LoadMediaFilesAsync());
            StateHasChanged();
        });
    }

    private async Task HandleChatHubReconnectedAsync(string? connectionId)
    {
        await InvokeAsync(async () =>
        {
            await Task.WhenAll(LoadMessagesAsync(), LoadMediaFilesAsync());
            StateHasChanged();
        });
    }

    private async Task HandleMessageKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && !args.ShiftKey && !_isChatClosed && !_isSendingMessage && (!string.IsNullOrWhiteSpace(_newMessage) || _pendingFiles.Count > 0))
        {
            await SendMessageAsync();
        }
    }

    private void AddPendingFile(IBrowserFile? file)
    {
        if (file is null)
        {
            return;
        }

        var extension = Path.GetExtension(file.Name);
        if (!AllowedMediaExtensionSet.Contains(extension))
        {
            Snackbar.Add("This file type is not allowed.", Severity.Error);
            return;
        }

        if (file.Size > MaximumMediaFileSize)
        {
            Snackbar.Add("The file must not exceed 10 MB.", Severity.Error);
            return;
        }

        _pendingFiles.Add(file);
    }

    private void RemovePendingFile(IBrowserFile file)
    {
        _pendingFiles.Remove(file);
    }

    private static string GetPendingFileTypeLabel(IBrowserFile file)
    {
        return Path.GetExtension(file.Name).TrimStart('.').ToUpperInvariant();
    }

    private async Task SendMessageAsync()
    {
        var messageContent = _newMessage.Trim();
        if (messageContent.Length == 0 && _pendingFiles.Count == 0)
        {
            return;
        }

        _isSendingMessage = true;

        try
        {
            var assignToCurrentUser = await GetAssignToCurrentUserAsync();

            if (messageContent.Length > 0)
            {
                using var response = await ApiClient.PostAsJsonAsync($"api/tickets/{_editedTicket.Id}/chat/messages", new
                {
                    Content = messageContent,
                    AssignToCurrentUser = assignToCurrentUser
                });
                response.EnsureSuccessStatusCode();

                var message = await response.Content.ReadFromJsonAsync<MessagePOCO>()
                    ?? throw new JsonException("The API returned an empty message response.");
                UpsertMessage(message);
                _editedTicket.ChatSessionId = message.ChatSessionId;
                _newMessage = string.Empty;
            }

            var filesToSend = _pendingFiles.ToList();
            _pendingFiles.Clear();
            foreach (var file in filesToSend)
            {
                await UploadFileAsync(file, assignToCurrentUser);
            }

            ApplyCurrentUserAssignment(assignToCurrentUser);
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or TaskCanceledException)
        {
            Snackbar.Add("Message could not be sent.", Severity.Error);
        }
        finally
        {
            _isSendingMessage = false;
            _shouldFocusMessageField = true;
        }
    }

    private async Task UploadFileAsync(IBrowserFile file, bool assignToCurrentUser)
    {
        try
        {
            await using var stream = file.OpenReadStream(MaximumMediaFileSize);
            using var fileContent = new StreamContent(stream);
            using var content = new MultipartFormDataContent();
            content.Add(fileContent, "File", file.Name);
            content.Add(new StringContent(assignToCurrentUser.ToString(CultureInfo.InvariantCulture)), "AssignToCurrentUser");

            using var response = await ApiClient.PostAsync($"api/tickets/{_editedTicket.Id}/chat/media", content);
            response.EnsureSuccessStatusCode();

            var mediaFile = await response.Content.ReadFromJsonAsync<MediaFilePOCO>()
                ?? throw new JsonException("The API returned an empty media response.");
            UpsertMediaFile(mediaFile);
            _editedTicket.ChatSessionId = mediaFile.ChatSessionId;
        }
        catch (Exception exception) when (exception is HttpRequestException or IOException or JsonException or TaskCanceledException)
        {
            Snackbar.Add($"File '{file.Name}' could not be uploaded.", Severity.Error);
        }
    }

    private async Task<bool> GetAssignToCurrentUserAsync()
    {
        if (!_isOperator || _editedTicket.OperatorId == _currentUserId)
        {
            return false;
        }

        if (_assignmentPromptHandled)
        {
            return _assignToCurrentUser;
        }

        _assignmentPromptHandled = true;
        _assignToCurrentUser = await DialogService.ShowMessageBoxAsync(
            "Assign ticket",
            "Do you want to assign this ticket to yourself?",
            yesText: "Assign to me",
            noText: "Continue without assigning") == true;
        return _assignToCurrentUser;
    }

    private void ApplyCurrentUserAssignment(bool assignToCurrentUser)
    {
        if (!assignToCurrentUser)
        {
            return;
        }

        _editedTicket.OperatorId = _currentUserId;
        _editedTicket.OperatorEmail = _currentUserEmail;
        _editedTicket.OperatorFirstName = _currentUserFirstName;
        _editedTicket.OperatorLastName = _currentUserLastName;
        _isReadOnly = false;
    }

    private void UpsertMessage(MessagePOCO message)
    {
        var messageIndex = _messages.FindIndex(existingMessage => existingMessage.Id == message.Id);
        if (messageIndex == -1)
        {
            _messages.Add(message);
        }
        else
        {
            _messages[messageIndex] = message;
        }

        _messages = _messages.OrderBy(existingMessage => existingMessage.SentAt).ToList();
    }

    private void UpsertMediaFile(MediaFilePOCO mediaFile)
    {
        var mediaFileIndex = _mediaFiles.FindIndex(existingMediaFile => existingMediaFile.Id == mediaFile.Id);
        if (mediaFileIndex == -1)
        {
            _mediaFiles.Insert(0, mediaFile);
        }
        else
        {
            _mediaFiles[mediaFileIndex] = mediaFile;
        }

        _mediaFiles = _mediaFiles.OrderByDescending(existingMediaFile => existingMediaFile.CreatedAt).ToList();
    }

    private async Task AutoSaveAsync()
    {
        if (_isReadOnly || _isSaving)
        {
            return;
        }

        _isSaving = true;

        try
        {
            _editedTicket.ClosedAt = _editedTicket.StatusId == TicketStatusOptions.ClosedId ? _editedTicket.ClosedAt ?? DateTimeOffset.Now : null;

            using var response = await ApiClient.PutAsJsonAsync($"api/tickets/{_editedTicket.Id}", _editedTicket);

            if (!response.IsSuccessStatusCode || !await response.Content.ReadFromJsonAsync<bool>())
            {
                Snackbar.Add("Ticket could not be updated.", Severity.Error);
                return;
            }

            var priority = _priorities.Single(priority => priority.Id == _editedTicket.PriorityId);
            _editedTicket.PriorityDisplayName = priority.DisplayName;
            _editedTicket.PriorityImpact = priority.Impact;
            _editedTicket.UpdatedAt = DateTimeOffset.Now;

            if (_canAssign)
            {
                var assignedOperator = _editedTicket.OperatorId.HasValue
                    ? _operators.Single(appOperator => appOperator.Id == _editedTicket.OperatorId.Value)
                    : null;
                _editedTicket.OperatorEmail = assignedOperator?.Email;
                _editedTicket.OperatorFirstName = assignedOperator?.FirstName;
                _editedTicket.OperatorLastName = assignedOperator?.LastName;
            }
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("The API is currently unavailable.", Severity.Error);
        }
        catch (JsonException)
        {
            Snackbar.Add("The API returned an invalid ticket response.", Severity.Error);
        }
        catch (TaskCanceledException)
        {
            Snackbar.Add("The ticket update timed out.", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task DeleteAsync()
    {
        var confirmed = await DialogService.ShowMessageBoxAsync("Delete ticket", $"Delete ticket #{_editedTicket.TicketNumber}?", yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        _isDeleting = true;

        try
        {
            using var response = await ApiClient.DeleteAsync($"api/tickets/{_editedTicket.Id}");

            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add("Ticket could not be deleted.", Severity.Error);
                return;
            }

            _dialogInstance.Close(DialogResult.Ok(_editedTicket.Id));
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("The API is currently unavailable.", Severity.Error);
        }
        catch (TaskCanceledException)
        {
            Snackbar.Add("The ticket delete request timed out.", Severity.Error);
        }
        finally
        {
            _isDeleting = false;
        }
    }

    private Color GetPriorityColor()
    {
        var priority = _priorities.FirstOrDefault(priority => priority.Id == _editedTicket.PriorityId);
        return TicketPriorityColorMapper.GetColor(priority?.Impact ?? _editedTicket.PriorityImpact);
    }

    private Color GetStatusColor()
    {
        return TicketStatusOptions.All.Single(status => status.Id == _editedTicket.StatusId).Color;
    }

    private static string GetMessageSenderName(MessagePOCO message)
    {
        return $"{message.SenderFirstName} {message.SenderLastName}";
    }

    private Color GetSenderColor(Guid senderId)
    {
        return senderId == _currentUserId ? Color.Primary : Color.Secondary;
    }

    private static string GetMediaUploaderName(MediaFilePOCO mediaFile)
    {
        return $"{mediaFile.UploaderFirstName} {mediaFile.UploaderLastName}";
    }

    private static string GetMediaFileName(MediaFilePOCO mediaFile)
    {
        return mediaFile.Extension.StartsWith('.') ? $"{mediaFile.Name}{mediaFile.Extension}" : $"{mediaFile.Name}.{mediaFile.Extension}";
    }

    private string GetMediaDownloadUrl(MediaFilePOCO mediaFile)
    {
        return $"/downloads/tickets/{_editedTicket.Id}/chat/media/{mediaFile.Id}";
    }

    private static string FormatFileSize(long sizeBytes)
    {
        return sizeBytes >= 1024 * 1024
            ? $"{sizeBytes / 1024d / 1024d:0.#} MB"
            : $"{sizeBytes / 1024d:0.#} KB";
    }

    public async ValueTask DisposeAsync()
    {
        _chatChangedSubscription?.Dispose();
        if (_chatHubConnection is not null)
        {
            _chatHubConnection.Reconnected -= HandleChatHubReconnectedAsync;
            await _chatHubConnection.DisposeAsync();
        }
    }
}

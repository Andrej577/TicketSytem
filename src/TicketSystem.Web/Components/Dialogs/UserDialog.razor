@using System.ComponentModel.DataAnnotations
@using System.Net
@using System.Text.Json
@using TicketSystem.Shared.DTO
@using TicketSystem.Shared.Enums
@inject TicketSystemApiClient ApiClient
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudAvatar Color="Color.Primary">
                    <MudIcon Icon="@(_isEditMode ? AppIcons.Actions.Edit : AppIcons.Actions.AddUser)" />
                </MudAvatar>
                <MudStack Spacing="0">
                    <MudText Typo="Typo.subtitle1">@(_isEditMode ? "Edit user account" : "Create a user account")</MudText>
                    <MudText Typo="Typo.body2">@_dialogDescription</MudText>
                </MudStack>
            </MudStack>

            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true">
                    @_errorMessage
                </MudAlert>
            }

            <MudForm @ref="_form">
                <MudStack Spacing="2">
                    <MudTextField T="string"
                                  Label="First name"
                                  Variant="Variant.Outlined"
                                  @bind-Value="_firstName"
                                  Required="true"
                                  RequiredError="First name is required."
                                  Immediate="true"
                                  Disabled="_isSubmitting" />

                    <MudTextField T="string"
                                  Label="Last name"
                                  Variant="Variant.Outlined"
                                  @bind-Value="_lastName"
                                  Required="true"
                                  RequiredError="Last name is required."
                                  Immediate="true"
                                  Disabled="_isSubmitting" />

                    <MudTextField T="string"
                                  Label="Email address"
                                  Placeholder="user@example.com"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Email"
                                  @bind-Value="_model.Email"
                                  Validation="@(new Func<string, string?>(ValidateEmail))"
                                  Immediate="true"
                                  Disabled="_isSubmitting" />

                    <MudTextField T="string"
                                  Label="@(_isEditMode ? "New password (optional)" : "Password")"
                                  Placeholder="@(_isEditMode ? "Leave blank to keep the current password" : "Enter a password")"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Password"
                                  @bind-Value="_model.Password"
                                  Validation="@(new Func<string, string?>(ValidatePassword))"
                                  Immediate="true"
                                  Disabled="_isSubmitting" />

                    <MudTextField T="string"
                                  Label="@(_isEditMode ? "Confirm new password" : "Confirm password")"
                                  Placeholder="@(_isEditMode ? "Repeat the new password" : "Repeat the password")"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Password"
                                  @bind-Value="_model.ConfirmPassword"
                                  Validation="@(new Func<string, string?>(ValidatePasswordConfirmation))"
                                  Immediate="true"
                                  Disabled="_isSubmitting" />
                </MudStack>
            </MudForm>
        </MudStack>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel" Disabled="_isSubmitting">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@(_isEditMode ? AppIcons.Actions.Edit : AppIcons.Actions.AddUser)" OnClick="SubmitAsync" Disabled="_isSubmitting">
            @if (_isSubmitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                <span>@(_isEditMode ? "Updating..." : "Creating...")</span>
            }
            else
            {
                <span>@(_isEditMode ? "Update" : "Create")</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance _mudDialog { get; set; } = null!;

    [Parameter]
    public AppUserDTO? User { get; set; }

    private readonly UserFormModel _model = new();
    private MudForm? _form;
    private string _firstName = string.Empty;
    private string _lastName = string.Empty;
    private bool _isSubmitting;
    private string? _errorMessage;

    private bool _isEditMode => User is not null;

    private string _dialogDescription => _isEditMode
        ? "Update the user's details or enter a new password."
        : "Enter the user's details and login credentials.";

    protected override void OnInitialized()
    {
        _firstName = User?.FirstName ?? string.Empty;
        _lastName = User?.LastName ?? string.Empty;
        _model.Email = User?.Email ?? string.Empty;
    }

    private async Task SubmitAsync()
    {
        if (_form is null || _isSubmitting)
        {
            return;
        }

        _isSubmitting = true;
        _errorMessage = null;

        try
        {
            await _form.ValidateAsync();
            if (!_form.IsValid)
            {
                return;
            }

            using var response = _isEditMode
                ? await UpdateUserAsync()
                : await CreateUserAsync();

            if (response.IsSuccessStatusCode)
            {
                var user = await response.Content.ReadFromJsonAsync<AppUserDTO>();

                if (user is null)
                {
                    _errorMessage = "The API returned an empty user response.";
                    return;
                }

                Snackbar.Add(_isEditMode ? "User updated successfully." : "User created successfully.", Severity.Success);
                _mudDialog.Close(DialogResult.Ok(user));
                return;
            }

            _errorMessage = GetErrorMessage(response.StatusCode);
        }
        catch (HttpRequestException)
        {
            _errorMessage = "The API is currently unavailable. Please try again later.";
        }
        catch (JsonException)
        {
            _errorMessage = "The API returned an invalid user response.";
        }
        catch (TaskCanceledException)
        {
            _errorMessage = "The user request timed out. Please try again.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private Task<HttpResponseMessage> CreateUserAsync()
    {
        return ApiClient.PostAsJsonAsync("api/app-users", new
        {
            Email = _model.Email.Trim(),
            FirstName = _firstName.Trim(),
            LastName = _lastName.Trim(),
            _model.Password,
            UserTypeId = (int)AppUserType.Customer
        });
    }

    private Task<HttpResponseMessage> UpdateUserAsync()
    {
        return ApiClient.PutAsJsonAsync($"api/app-users/{User!.Id}", new
        {
            Email = _model.Email.Trim(),
            FirstName = _firstName.Trim(),
            LastName = _lastName.Trim(),
            Password = string.IsNullOrWhiteSpace(_model.Password) ? null : _model.Password
        });
    }

    private string GetErrorMessage(HttpStatusCode statusCode)
    {
        return statusCode switch
        {
            HttpStatusCode.Conflict => "A user with this email address already exists.",
            HttpStatusCode.BadRequest => "Please check the entered user information.",
            HttpStatusCode.NotFound when _isEditMode => "The user no longer exists.",
            _ when _isEditMode => "The user could not be updated. Please try again.",
            _ => "The user could not be created. Please try again."
        };
    }

    private void Cancel()
    {
        _mudDialog.Cancel();
    }

    private static string? ValidateEmail(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "Email address is required.";
        }

        return new EmailAddressAttribute().IsValid(value)
            ? null
            : "Enter a valid email address.";
    }

    private string? ValidatePassword(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return _isEditMode ? null : "Password is required.";
        }

        return value.Length >= 8
            ? null
            : "Password must contain at least 8 characters.";
    }

    private string? ValidatePasswordConfirmation(string value)
    {
        if (string.IsNullOrWhiteSpace(_model.Password))
        {
            if (!_isEditMode)
            {
                return "Confirm the password.";
            }

            return string.IsNullOrWhiteSpace(value)
                ? null
                : "Enter a new password before confirming it.";
        }

        if (string.IsNullOrWhiteSpace(value))
        {
            return _isEditMode ? "Confirm the new password." : "Confirm the password.";
        }

        return value == _model.Password
            ? null
            : "Passwords do not match.";
    }

    private sealed class UserFormModel
    {
        public string Email { get; set; } = string.Empty;

        public string Password { get; set; } = string.Empty;

        public string ConfirmPassword { get; set; } = string.Empty;
    }
}

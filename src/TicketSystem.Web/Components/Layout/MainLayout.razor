@inherits LayoutComponentBase

<MudThemeProvider Theme="TicketSystemTheme.Default" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Class="ticket-layout">
    <MudAppBar Elevation="0" Class="ticket-appbar">
        <MudLink Href="/" Underline="Underline.None" Class="ticket-brand">
            <span class="ticket-logo">T</span>
            <span class="ticket-brand-copy">
                <strong>Ticket <span>System</span></strong>
                <small>SUPPORT</small>
            </span>
        </MudLink>

        <nav class="ticket-navigation" aria-label="Main navigation">
            <NavLink href="/" Match="NavLinkMatch.All" class="ticket-nav-link"><MudIcon Icon="@Icons.Material.Outlined.Dashboard" />Overview</NavLink>
            <NavLink href="/tickets" class="ticket-nav-link"><MudIcon Icon="@Icons.Material.Outlined.Inbox" />Inbox</NavLink>
            <NavLink href="/tickets/new" class="ticket-nav-link"><MudIcon Icon="@Icons.Material.Outlined.Add" />New ticket</NavLink>
            <NavLink href="/customers" class="ticket-nav-link"><MudIcon Icon="@Icons.Material.Outlined.People" />Customers</NavLink>
            <NavLink href="/knowledge-base" class="ticket-nav-link"><MudIcon Icon="@Icons.Material.Outlined.MenuBook" />Knowledge base</NavLink>
        </nav>

        <MudSpacer />

        <MudIconButton Icon="@Icons.Material.Outlined.Search" Class="ticket-header-action" aria-label="Search" />
        <MudIconButton Icon="@Icons.Material.Outlined.NotificationsNone" Class="ticket-header-action" aria-label="Notifications" />
        <MudAvatar Class="ticket-user-placeholder"><MudIcon Icon="@Icons.Material.Outlined.Person" /></MudAvatar>
    </MudAppBar>

    <MudMainContent Class="ticket-main">
        @Body
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui">
    An unexpected error occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">×</a>
</div>

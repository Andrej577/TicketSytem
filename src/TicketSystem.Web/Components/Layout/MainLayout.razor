@inherits LayoutComponentBase
@implements IDisposable
@inject ThemeState ThemeState
@inject IJSRuntime JSRuntime

<MudThemeProvider Theme="_theme" IsDarkMode="@ThemeState.IsDarkMode" ObserveSystemDarkModeChange="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudText Typo="Typo.h6">Ticket System</MudText>
            <AuthorizeView Roles="@nameof(AppUserType.Administrator)">
                <MudButton Href="/" Variant="Variant.Text" Color="Color.Inherit" StartIcon="@_overviewIcon">Overview</MudButton>
            </AuthorizeView>
            <AuthorizeView>
                <Authorized>
                    <MudButton Href="/tickets" Variant="Variant.Text" Color="Color.Inherit" StartIcon="@_ticketsIcon">Tickets</MudButton>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Roles="@nameof(AppUserType.Administrator)">
                <MudButton Href="/users" Variant="Variant.Text" Color="Color.Inherit" StartIcon="@_usersIcon">Users</MudButton>
            </AuthorizeView>
            <AuthorizeView Roles="Operator,Administrator">
                <MudButton Href="/knowledge-base" Variant="Variant.Text" Color="Color.Inherit" StartIcon="@_knowledgeBaseIcon">Knowledge base</MudButton>
            </AuthorizeView>
        </MudStack>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <MudIconButton Icon="@(_isDarkMode ? _lightModeIcon : _darkModeIcon)" Color="Color.Inherit" OnClick="ToggleDarkModeAsync" aria-label="Toggle dark mode" />
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Roles="@nameof(AppUserType.Administrator)">
            <MudIconButton Icon="@_notificationIcon" Color="Color.Inherit" aria-label="Notifications" />
        </AuthorizeView>
        <AuthorizeView>
            <Authorized Context="authenticationState">
                <MudMenu @ref="_userAccountMenu" Class="user-account-menu">
                    <ActivatorContent>
                        <MudButton Variant="Variant.Text" Color="Color.Inherit" EndIcon="@Icons.Material.Filled.ArrowDropDown" OnClick="@(() => _userAccountMenu!.ToggleMenuAsync(new MouseEventArgs()))">@authenticationState.User.Identity?.Name</MudButton>
                    </ActivatorContent>
                    <ChildContent>
                        <MudMenuItem>
                            <form method="post" action="/auth/logout" class="user-account-logout-form">
                                <AntiforgeryToken />
                                <button type="submit" class="user-account-logout-button">
                                    <MudIcon Icon="@Icons.Material.Outlined.Logout" Size="Size.Small" />
                                    <span>Logout</span>
                                </button>
                            </form>
                        </MudMenuItem>
                    </ChildContent>
                </MudMenu>
            </Authorized>
            <NotAuthorized>
                <MudButton Href="/login" Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Outlined.Login">Login</MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>

<style>
    .user-account-logout-form {
        margin: 0;
    }

    .user-account-logout-button {
        all: unset;
        display: flex;
        align-items: center;
        gap: 8px;
        width: 100%;
        cursor: pointer;
    }
</style>

<div id="blazor-error-ui">
    An unexpected error occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">×</a>
</div>

@code {
    protected override void OnInitialized()
    {
        ThemeState.Changed += HandleThemeChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ThemeState.InitializeAsync(JSRuntime);
        }
    }

    private void HandleThemeChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private bool _isDarkMode => ThemeState.IsDarkMode;


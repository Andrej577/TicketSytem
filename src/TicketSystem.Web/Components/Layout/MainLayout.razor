@inherits LayoutComponentBase

<MudThemeProvider IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudText Typo="Typo.h6">Ticket System</MudText>
            <MudButton Href="/" Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Outlined.Dashboard">Overview</MudButton>
            <MudButton Href="/tickets" Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Outlined.Inbox">Tickets</MudButton>
            <MudButton Href="/users" Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Outlined.People">Users</MudButton>
            <MudButton Href="/knowledge-base" Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Outlined.MenuBook">Knowledge base</MudButton>
        </MudStack>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Outlined.Search" Color="Color.Inherit" aria-label="Search" />
        <MudIconButton Icon="@Icons.Material.Outlined.NotificationsNone" Color="Color.Inherit" aria-label="Notifications" />
        <MudAvatar Color="Color.Primary" Size="Size.Small"><MudIcon Icon="@Icons.Material.Outlined.Person" /></MudAvatar>
    </MudAppBar>

    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui">
    An unexpected error occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">×</a>
</div>

@page "/"

<PageTitle>All Tickets</PageTitle>

<div class="ticket-workspace">
    <div class="ticket-viewbar">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="ticket-view-title">
            <MudIcon Icon="@Icons.Material.Outlined.StarBorder" Size="Size.Small" />
            <MudText Typo="Typo.h6">All Tickets</MudText>
            <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" />
        </MudStack>

        <MudSpacer />

        <MudButtonGroup Size="Size.Small" Variant="Variant.Outlined" Class="ticket-display-toggle">
            <MudIconButton Icon="@Icons.Material.Outlined.ViewList" Size="Size.Small" />
            <MudIconButton Icon="@Icons.Material.Outlined.ViewColumn" Size="Size.Small" Class="ticket-display-active" />
            <MudIconButton Icon="@Icons.Material.Outlined.KeyboardArrowDown" Size="Size.Small" />
        </MudButtonGroup>
        <MudIconButton Icon="@Icons.Material.Outlined.MoreHoriz" Size="Size.Small" Class="ticket-more-button" />
    </div>

    <div class="ticket-board-shell">
        <div class="ticket-board">
            @foreach (var column in Columns)
            {
                <section class="ticket-column">
                    <div class="ticket-column-header">
                        <MudText Typo="Typo.subtitle2" Class="@column.HeaderClass">@column.Title</MudText>
                    </div>

                    @foreach (var item in column.Items)
                    {
                        <MudPaper Elevation="0" Class="ticket-card">
                            <div class="ticket-card-icon @item.IconClass">
                                <MudIcon Icon="@item.Icon" Size="Size.Small" />
                            </div>

                            <div class="ticket-card-body">
                                <MudText Typo="Typo.subtitle2" Class="ticket-card-title">@item.Title</MudText>
                                <div class="ticket-card-owner">@item.Owner</div>
                                <div class="ticket-card-meta">
                                    <span>@item.DueText</span>
                                    <span>@item.Status</span>
                                    <span class="ticket-card-count">@item.Count</span>
                                </div>
                            </div>

                            <MudAvatar Size="Size.Small" Class="ticket-card-avatar">@item.Initials</MudAvatar>
                        </MudPaper>
                    }
                </section>
            }
        </div>

        <aside class="ticket-phone-preview">
            <div class="ticket-phone-speaker"></div>
            <div class="ticket-phone-screen">
                <div class="ticket-phone-status">Vodafone IN <span>12:14 PM</span></div>
                <div class="ticket-phone-header">
                    <MudIcon Icon="@Icons.Material.Outlined.ChevronLeft" Size="Size.Small" />
                    <span>Open Tickets</span>
                    <MudIcon Icon="@Icons.Material.Outlined.Search" Size="Size.Small" />
                    <MudIcon Icon="@Icons.Material.Outlined.Add" Size="Size.Small" />
                </div>
                <div class="ticket-phone-tabs">
                    <span class="ticket-phone-tab-active"></span>
                    <span></span>
                    <span></span>
                </div>

                @foreach (var item in MobileTickets)
                {
                    <div class="ticket-phone-item">
                        <MudIcon Icon="@item.Icon" Size="Size.Small" />
                        <div>
                            <strong>@item.Title</strong>
                            <span>@item.Owner - @item.Status</span>
                        </div>
                    </div>
                }
            </div>
            <div class="ticket-phone-home"></div>
        </aside>
    </div>
</div>


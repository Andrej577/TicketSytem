@page "/"

<PageTitle>Ticket System</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
    <MudPaper Class="pa-4 mb-4" aria-label="Dashboard filters">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudText Typo="Typo.overline">Filters</MudText>
            <MudSelect T="string" Label="Organization" Variant="Variant.Outlined" Dense="true" Disabled="true" />
            <MudSelect T="string" Label="Category" Variant="Variant.Outlined" Dense="true" Disabled="true" />
            <MudIconButton Icon="@Icons.Material.Outlined.Add" Disabled="true" aria-label="Add filter" />
            <MudSpacer />
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudIcon Icon="@Icons.Material.Outlined.Schedule" Size="Size.Small" />
                <MudText Typo="Typo.caption">No period selected</MudText>
            </MudStack>
        </MudStack>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Outlined.FilterList" />
            <MudTextField T="string" Placeholder="Search by title, user, or tag…" Variant="Variant.Text" Margin="Margin.Dense" FullWidth="true" Disabled="true" />
        </MudStack>
    </MudPaper>

    <MudGrid Spacing="3">
        <MudItem xs="12" md="6" lg="4">
            <MudPaper Class="pa-4">
                <DashboardCardHeader Title="Recent activity" Subtitle="Activity will appear when data is connected" />
                <MudDivider Class="my-4" />
                <EmptyDashboardState Icon="@Icons.Material.Outlined.History" Text="No activity available" />
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6" lg="4">
            <MudPaper Class="pa-4">
                <DashboardCardHeader Title="Most active categories" Subtitle="Ticket category overview" />
                <MudDivider Class="my-4" />
                <EmptyDashboardState Icon="@Icons.Material.Outlined.DonutLarge" Text="No category data available" />
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6" lg="4">
            <MudPaper Class="pa-4">
                <DashboardCardHeader Title="First response time" Subtitle="Response time trend" />
                <MudDivider Class="my-4" />
                <EmptyDashboardState Icon="@Icons.Material.Outlined.ShowChart" Text="No response data available" />
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6" lg="4">
            <MudPaper Class="pa-4">
                <DashboardCardHeader Title="Tickets by location" Subtitle="Ticket distribution" />
                <MudDivider Class="my-4" />
                <EmptyDashboardState Icon="@Icons.Material.Outlined.LocationOn" Text="No location data available" />
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6" lg="4">
            <MudPaper Class="pa-4">
                <DashboardCardHeader Title="Ticket overview" Subtitle="Statuses and priorities" />
                <MudDivider Class="my-4" />
                <EmptyDashboardState Icon="@Icons.Material.Outlined.ConfirmationNumber" Text="No tickets available" />
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6" lg="4">
            <MudPaper Class="pa-4">
                <DashboardCardHeader Title="Summary" Subtitle="Key indicators" />
                <MudDivider Class="my-4" />
                <EmptyDashboardState Icon="@Icons.Material.Outlined.QueryStats" Text="No indicators available" />
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

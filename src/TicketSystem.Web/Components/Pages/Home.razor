    private IEnumerable<TicketItem> MobileTickets => Columns.SelectMany(column => column.Items).Take(7);

    private sealed record TicketColumn(string Title, string HeaderClass, TicketItem[] Items);

    private sealed record TicketItem(
        string Title,
        string Owner,
        string DueText,
        string Status,
        string Count,
        string Initials,
        string Icon,
        string IconClass);
}

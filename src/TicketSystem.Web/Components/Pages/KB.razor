@page "/knowledge-base"
@attribute [Authorize(Roles = "Operator,Administrator")]
@implements IAsyncDisposable
@using System.Globalization
@using System.Text.Json
@using Microsoft.AspNetCore.SignalR.Client
@using TicketSystem.Shared.Realtime
@inject IDialogService DialogService
@inject TicketSystemApiClient ApiClient
@inject IConfiguration Configuration
@inject ISnackbar Snackbar
@inject LoadingState LoadingState

<PageTitle>Knowledge base | Ticket System</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
    <MudStack Spacing="3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h4">Knowledge base</MudText>
            </MudStack>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add" OnClick="@(() => OpenKnowledgeDialogAsync(null))" Disabled="@(_isLoading || _statuses.Count == 0)">
                New article
            </MudButton>
        </MudStack>

        @if (!string.IsNullOrWhiteSpace(_loadErrorMessage))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.subtitle1">Knowledge base could not be loaded</MudText>
                    <MudText Typo="Typo.body2">@_loadErrorMessage</MudText>
                    <MudButton Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Outlined.Refresh" OnClick="LoadKnowledgeAsync">Try again</MudButton>
                </MudStack>
            </MudAlert>
        }
        else
        {
            <MudPaper Outlined="true" Class="pa-4">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudTextField T="string"
                                  @bind-Value="_searchText"
                                  Placeholder="Search articles..."
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Outlined.Search"
                                  Style="flex: 1 1 auto;" />
                    <MudSelect T="short?"
                               Label="Status"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               @bind-Value="_statusFilter"
                               Clearable="true"
                               Style="width: 200px;">
                        @foreach (var status in _statuses)
                        {
                            <MudSelectItem T="short?" Value="@((short?)status.Id)">@status.Name</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect T="Guid?"
                               Label="Category"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               @bind-Value="_categoryFilter"
                               Clearable="true"
                               Disabled="@(_categories.Count == 0)"
                               Style="width: 220px;">
                        @foreach (var category in _categories)
                        {
                            <MudSelectItem T="Guid?" Value="@((Guid?)category.Id)">@category.Name</MudSelectItem>
                        }
                    </MudSelect>
                    @if (_hasActiveFilters)
                    {
                        <MudIconButton Icon="@Icons.Material.Outlined.FilterAltOff" Color="Color.Primary" OnClick="ClearFilters" aria-label="Clear filters" />
                    }
                </MudStack>
            </MudPaper>

            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.subtitle2">@_visibleArticleTotalText</MudText>
                <MudStack Row="true" Spacing="1">
                    @foreach (var status in _statuses)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@KnowledgeStatusColorMapper.GetColor(status.Id)">
                            @status.Name: @_articles.Count(article => article.StatusId == status.Id)
                        </MudChip>
                    }
                </MudStack>
            </MudStack>

            @if (_visibleArticles.Count == 0)
            {
                <MudPaper Outlined="true" Class="pa-8">
                    <MudStack AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@(_articles.Count == 0 ? Icons.Material.Outlined.MenuBook : Icons.Material.Outlined.SearchOff)" Size="Size.Large" Color="Color.Primary" />
                        <MudText Typo="Typo.h6">@(_articles.Count == 0 ? "No knowledge articles" : "No matching articles")</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @(_articles.Count == 0 ? "Create the first article for your support team." : "Clear or change the filters to see more articles.")
                        </MudText>
                        @if (_articles.Count == 0)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add" OnClick="@(() => OpenKnowledgeDialogAsync(null))" Disabled="@(_statuses.Count == 0)">
                                Create article
                            </MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.FilterAltOff" OnClick="ClearFilters">
                                Clear filters
                            </MudButton>
                        }
                    </MudStack>
                </MudPaper>
            }
            else
            {
                <MudGrid Spacing="3">
                    @foreach (var article in _visibleArticles)
                    {
                        <MudItem xs="12" sm="6" lg="4">
                            <MudCard Outlined="true" Style="height: 100%; cursor: pointer;" @onclick="@(() => OpenKnowledgeDialogAsync(article))">
                                <MudCardContent>
                                    <MudStack Spacing="2">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                            <MudChip T="string" Size="Size.Small" Color="@KnowledgeStatusColorMapper.GetColor(article.StatusId)">
                                                @article.StatusName
                                            </MudChip>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                @article.UpdatedAt.ToString("dd MMM yyyy", CultureInfo.InvariantCulture)
                                            </MudText>
                                        </MudStack>

                                        <MudText Typo="Typo.h6">@article.Title</MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">@GetContentPreview(article.Content)</MudText>

                                        <MudDivider />

                                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Outlined.Folder">
                                                @(article.CategoryName ?? "Uncategorized")
                                            </MudChip>
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                <MudIcon Icon="@Icons.Material.Outlined.Person" Size="Size.Small" Color="Color.Secondary" />
                                                <MudText Typo="Typo.caption">@article.AuthorEmail</MudText>
                                            </MudStack>
                                        </MudStack>
                                    </MudStack>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    }
                </MudGrid>
            }
        }
    </MudStack>
</MudContainer>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> _authenticationState { get; set; } = default!;

    private List<KnowledgePOCO> _articles = [];
    private List<KnowledgeCategoryDTO> _categories = [];
    private List<KnowledgeStatusDTO> _statuses = [];
    private HubConnection? _knowledgeHubConnection;
    private IDisposable? _knowledgeChangedSubscription;
    private Guid? _categoryFilter;
    private short? _statusFilter;
    private string _searchText = string.Empty;
    private string? _loadErrorMessage;
    private bool _isAdministrator;
    private bool _isLoading = true;

    private IReadOnlyList<KnowledgePOCO> _visibleArticles => _articles
        .Where(MatchesFilters)
        .OrderByDescending(article => article.UpdatedAt)
        .ToList();

    private bool _hasActiveFilters => !string.IsNullOrWhiteSpace(_searchText) || _statusFilter is not null || _categoryFilter is not null;

    private string _visibleArticleTotalText => _visibleArticles.Count == 1 ? "1 article" : $"{_visibleArticles.Count} articles";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var authenticationState = await _authenticationState;
        _isAdministrator = authenticationState.User.IsInRole(nameof(AppUserType.Administrator));
        var accessToken = authenticationState.User.FindFirst(TicketSystemClaimTypes.ApiAccessToken)!.Value;
        await ConnectToKnowledgeHubAsync(accessToken);
        await LoadKnowledgeAsync();
        StateHasChanged();
    }

    private async Task ConnectToKnowledgeHubAsync(string accessToken)
    {
        var realtimeBaseUrl = Configuration["Realtime:BaseUrl"]
            ?? throw new InvalidOperationException("The 'Realtime:BaseUrl' configuration value is required.");

        _knowledgeHubConnection = new HubConnectionBuilder()
            .WithUrl($"{realtimeBaseUrl.TrimEnd('/')}{RealtimeHubRoutes.Knowledge}", options =>
            {
                options.AccessTokenProvider = () => Task.FromResult<string?>(accessToken);
            })
            .WithAutomaticReconnect()
            .Build();
        _knowledgeChangedSubscription = _knowledgeHubConnection.On(KnowledgeRealtimeEvents.Changed, HandleKnowledgeChangedAsync);
        _knowledgeHubConnection.Reconnected += HandleKnowledgeHubReconnectedAsync;

        for (var attempt = 1; attempt <= 3; attempt++)
        {
            try
            {
                await _knowledgeHubConnection.StartAsync();
                return;
            }
            catch (Exception exception) when (exception is HttpRequestException or InvalidOperationException or TaskCanceledException)
            {
                if (attempt == 3)
                {
                    Snackbar.Add("Live knowledge base updates are currently unavailable.", Severity.Warning);
                    return;
                }

                await Task.Delay(TimeSpan.FromSeconds(1));
            }
        }
    }

    private async Task HandleKnowledgeChangedAsync()
    {
        await InvokeAsync(ReloadArticlesAsync);
    }

    private async Task HandleKnowledgeHubReconnectedAsync(string? connectionId)
    {
        await HandleKnowledgeChangedAsync();
    }

    private async Task ReloadArticlesAsync()
    {
        try
        {
            _articles = await ApiClient.GetFromJsonAsync<List<KnowledgePOCO>>("api/knowledge") ?? [];
            StateHasChanged();
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or TaskCanceledException)
        {
            Snackbar.Add("Knowledge articles could not be refreshed.", Severity.Warning);
        }
    }

    private async Task LoadKnowledgeAsync()
    {
        using var loadingScope = LoadingState.BeginLoading();
        _isLoading = true;
        _loadErrorMessage = null;

        try
        {
            var articlesTask = ApiClient.GetFromJsonAsync<List<KnowledgePOCO>>("api/knowledge");
            var statusesTask = ApiClient.GetFromJsonAsync<List<KnowledgeStatusDTO>>("api/knowledge-statuses");
            var categoriesTask = ApiClient.GetFromJsonAsync<List<KnowledgeCategoryDTO>>("api/knowledge-categories");

            await Task.WhenAll(articlesTask, statusesTask, categoriesTask);
            _articles = await articlesTask ?? [];
            _statuses = await statusesTask ?? [];
            _categories = await categoriesTask ?? [];
        }
        catch (HttpRequestException)
        {
            _loadErrorMessage = "The API is currently unavailable. Please try again later.";
        }
        catch (JsonException)
        {
            _loadErrorMessage = "The API returned invalid knowledge base data.";
        }
        catch (TaskCanceledException)
        {
            _loadErrorMessage = "The knowledge base request timed out.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OpenKnowledgeDialogAsync(KnowledgePOCO? article)
    {
        var parameters = new DialogParameters
        {
            [nameof(KnowledgeDialog._article)] = article,
            [nameof(KnowledgeDialog._statuses)] = _statuses,
            [nameof(KnowledgeDialog._categories)] = _categories,
            [nameof(KnowledgeDialog._canDelete)] = _isAdministrator
        };
        var options = new DialogOptions
        {
            CloseButton = true,
            FullWidth = true,
            MaxWidth = MaxWidth.Medium,
            BackdropClick = false
        };

        var dialog = await DialogService.ShowAsync<KnowledgeDialog>(article is null ? "New knowledge article" : "Edit knowledge article", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled)
        {
            return;
        }

        if (result.Data is KnowledgePOCO savedArticle)
        {
            UpsertArticle(savedArticle);
        }
        else if (result.Data is Guid deletedArticleId)
        {
            _articles.RemoveAll(existingArticle => existingArticle.Id == deletedArticleId);
        }

        _articles = [.. _articles];
        StateHasChanged();
    }

    private void UpsertArticle(KnowledgePOCO article)
    {
        var articleIndex = _articles.FindIndex(existingArticle => existingArticle.Id == article.Id);
        if (articleIndex == -1)
        {
            _articles.Insert(0, article);
            return;
        }

        _articles[articleIndex] = article;
    }

    private bool MatchesFilters(KnowledgePOCO article)
    {
        if (_statusFilter is not null && article.StatusId != _statusFilter)
        {
            return false;
        }

        if (_categoryFilter is not null && article.CategoryId != _categoryFilter)
        {
            return false;
        }

        if (string.IsNullOrWhiteSpace(_searchText))
        {
            return true;
        }

        var searchText = _searchText.Trim();
        return article.Title.Contains(searchText, StringComparison.OrdinalIgnoreCase)
            || article.Content.Contains(searchText, StringComparison.OrdinalIgnoreCase)
            || article.AuthorEmail.Contains(searchText, StringComparison.OrdinalIgnoreCase)
            || article.StatusName.Contains(searchText, StringComparison.OrdinalIgnoreCase)
            || (article.CategoryName?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private void ClearFilters()
    {
        _searchText = string.Empty;
        _statusFilter = null;
        _categoryFilter = null;
    }

    private static string GetContentPreview(string content)
    {
        var preview = content.Replace("\r", " ").Replace("\n", " ").Trim();
        return preview.Length <= 180 ? preview : $"{preview[..180].TrimEnd()}…";
    }

    public async ValueTask DisposeAsync()
    {
        _knowledgeChangedSubscription?.Dispose();
        if (_knowledgeHubConnection is not null)
        {
            _knowledgeHubConnection.Reconnected -= HandleKnowledgeHubReconnectedAsync;
            await _knowledgeHubConnection.DisposeAsync();
        }
    }
}

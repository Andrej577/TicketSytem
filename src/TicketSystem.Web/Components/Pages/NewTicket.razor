@page "/tickets/new"

<PageTitle>New ticket | Ticket System</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
    <MudStack Spacing="4">
        <MudStack Spacing="1">
            <MudText Typo="Typo.overline">New work order</MudText>
            <MudText Typo="Typo.h4">Open a new ticket</MudText>
            <MudText Typo="Typo.body1">Report an incident or request in a few clear steps.</MudText>
        </MudStack>

        <MudGrid Spacing="4">
            <MudItem xs="12" md="8">
                <MudPaper Elevation="1" Class="pa-6">
                    <MudForm @ref="ticketForm">
                        <MudStack Spacing="4">
                            <MudTextField @bind-Value="ticketTitle"
                                          Label="Ticket title"
                                          Placeholder="Briefly describe the issue"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          FullWidth="true"
                                          MaxLength="200"
                                          Counter="200" />

                            <MudGrid Spacing="3">
                                <MudItem xs="12" sm="6">
                                    <MudSelect T="Guid?"
                                               @bind-Value="categoryId"
                                               Label="Category"
                                               Placeholder="Select a category"
                                               Variant="Variant.Outlined"
                                               Margin="Margin.Dense"
                                               FullWidth="true"
                                               Disabled="true" />
                                    <MudText Typo="Typo.caption">Categories will be available when API data is connected.</MudText>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudSelect T="short?"
                                               @bind-Value="priorityId"
                                               Label="Priority"
                                               Placeholder="Select a priority"
                                               Variant="Variant.Outlined"
                                               Margin="Margin.Dense"
                                               FullWidth="true"
                                               Disabled="true" />
                                    <MudText Typo="Typo.caption">Priorities will be available when API data is connected.</MudText>
                                </MudItem>
                            </MudGrid>

                            <MudTextField @bind-Value="description"
                                          Label="Issue description"
                                          Placeholder="What happened? When did you first notice the issue?"
                                          Variant="Variant.Outlined"
                                          Lines="7"
                                          FullWidth="true"
                                          MaxLength="4000"
                                          Counter="4000" />

                            <MudButton Variant="Variant.Outlined"
                                       StartIcon="@Icons.Material.Outlined.AttachFile"
                                       FullWidth="true"
                                       Disabled="true">
                                <span><strong>Add an attachment</strong><br /><small>PNG, JPG, PDF, or LOG up to 10 MB</small></span>
                            </MudButton>

                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd" Spacing="2">
                                <MudButton Variant="Variant.Text" Disabled="true">Save draft</MudButton>
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           EndIcon="@Icons.Material.Outlined.ArrowForward"
                                           Disabled="true">
                                    Submit ticket
                                </MudButton>
                            </MudStack>
                        </MudStack>
                    </MudForm>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudPaper Elevation="1" Class="pa-6">
                    <MudStack Spacing="3">
                        <MudIcon Icon="@Icons.Material.Outlined.Schedule" Size="Size.Large" Color="Color.Primary" />
                        <MudText Typo="Typo.h6">A clear request gets a faster response.</MudText>
                        <MudText Typo="Typo.body2">The more context you provide, the easier it is for the support team to understand the issue.</MudText>

                        <MudStack Spacing="2">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudAvatar Color="Color.Primary" Size="Size.Small">01</MudAvatar>
                                <MudText Typo="Typo.body2"><strong>Describe what happened</strong></MudText>
                            </MudStack>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudAvatar Color="Color.Primary" Size="Size.Small">02</MudAvatar>
                                <MudText Typo="Typo.body2"><strong>Add a screenshot or file</strong></MudText>
                            </MudStack>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudAvatar Color="Color.Primary" Size="Size.Small">03</MudAvatar>
                                <MudText Typo="Typo.body2"><strong>Track replies in your portal</strong></MudText>
                            </MudStack>
                        </MudStack>

                        <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true">
                            Submission will be enabled when the ticket API is connected.
                        </MudAlert>
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudStack>
</MudContainer>

@code {
    private MudForm? ticketForm;
    private string ticketTitle = string.Empty;
    private string description = string.Empty;
    private Guid? categoryId;
    private short? priorityId;
}

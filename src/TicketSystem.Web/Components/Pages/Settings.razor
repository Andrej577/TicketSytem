@page "/settings"
@attribute [Authorize]
@implements IDisposable
@inject ThemeState ThemeState
@inject IJSRuntime JSRuntime

<PageTitle>Settings | Ticket System</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="pa-4">
    <MudStack Spacing="3">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">Settings</MudText>
        </MudStack>

        <MudPaper Outlined="true" Class="pa-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudAvatar Color="Color.Primary">
                    <MudIcon Icon="@(_isDarkMode ? Icons.Material.Outlined.DarkMode : Icons.Material.Outlined.LightMode)" />
                </MudAvatar>
                <MudStack Spacing="0">
                    <MudText Typo="Typo.h6">Appearance</MudText>
                </MudStack>
                <MudSpacer />
                <MudSwitch T="bool" Value="_isDarkMode" ValueChanged="SetDarkModeAsync" Color="Color.Primary" Label="Dark mode" />
            </MudStack>
        </MudPaper>
    </MudStack>
</MudContainer>

@code {
    private bool _isDarkMode;

    protected override void OnInitialized()
    {
        _isDarkMode = ThemeState.IsDarkMode;
        ThemeState.Changed += HandleThemeChanged;
    }

    private async Task SetDarkModeAsync(bool isDarkMode)
    {
        await ThemeState.SetDarkModeAsync(isDarkMode, JSRuntime);
    }

    private void HandleThemeChanged()
    {
        _isDarkMode = ThemeState.IsDarkMode;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ThemeState.Changed -= HandleThemeChanged;
    }
}

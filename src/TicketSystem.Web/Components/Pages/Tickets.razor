@page "/tickets"

<PageTitle>Inbox | Ticket System</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="ticket-list-page">
    <header class="ticket-list-heading">
        <div>
            <MudText Typo="Typo.h4" Class="ticket-list-title">Inbox</MudText>
        </div>
        <MudButton Href="/tickets/new"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Outlined.Add"
                   Class="ticket-create-button">
            New ticket
        </MudButton>
    </header>

    <section class="ticket-list-toolbar" aria-label="Ticket search and filters">
        <div class="ticket-list-search">
            <MudIcon Icon="@Icons.Material.Outlined.Search" Size="Size.Small" />
            <MudTextField T="string"
                          Placeholder="Search tickets..."
                          Variant="Variant.Text"
                          Margin="Margin.Dense"
                          Class="ticket-search-field"
                          Disabled="true" />
        </div>
        <div class="ticket-list-filters">
            <MudButton Variant="Variant.Outlined" EndIcon="@Icons.Material.Outlined.ExpandMore" Disabled="true">Status: All</MudButton>
            <MudButton Variant="Variant.Outlined" EndIcon="@Icons.Material.Outlined.ExpandMore" Disabled="true">Priority: All</MudButton>
            <MudButton Variant="Variant.Outlined" EndIcon="@Icons.Material.Outlined.ExpandMore" Disabled="true">Technician</MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.FilterList" EndIcon="@Icons.Material.Outlined.ExpandMore" Disabled="true">More filters</MudButton>
        </div>
    </section>

    <section class="ticket-table-shell" aria-label="Ticket list">
        <div class="ticket-table-header" role="row">
            <span>ID</span>
            <span>Ticket / User</span>
            <span>Category</span>
            <span>Priority</span>
            <span>SLA due</span>
            <span>Status</span>
            <span>Assignee</span>
        </div>
        <div class="ticket-table-empty">
            <span class="ticket-table-empty-icon"><MudIcon Icon="@Icons.Material.Outlined.Inbox" /></span>
            <MudText Typo="Typo.subtitle1">No tickets yet</MudText>
            <MudText Typo="Typo.body2">Tickets will appear here when data is connected.</MudText>
            <MudButton Href="/tickets/new"
                       Variant="Variant.Text"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Outlined.Add"
                       Class="ticket-empty-create-button">
                Create a ticket
            </MudButton>
        </div>
    </section>
</MudContainer>

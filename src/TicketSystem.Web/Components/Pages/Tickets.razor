@page "/tickets"
@attribute [Authorize]
@implements IAsyncDisposable
@using System.Globalization
@using System.Text.Json
@using Microsoft.AspNetCore.SignalR.Client
@using TicketSystem.Shared.Realtime
@inject IDialogService DialogService
@inject TicketSystemApiClient ApiClient
@inject IConfiguration Configuration
@inject ISnackbar Snackbar
@inject LoadingState LoadingState

<PageTitle>Tickets | Ticket System</PageTitle>
<HeadContent>
    <link rel="stylesheet" href="https://cdn-uicons.flaticon.com/4.0.0/uicons-regular-straight/css/uicons-regular-straight.css" />
</HeadContent>

<MudContainer MaxWidth="MaxWidth.False" Class="pa-4 tickets-page">
    <MudStack Spacing="3" Class="tickets-page-content">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudText Typo="Typo.h4">Tickets</MudText>

            @if (_isCustomer)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@AppIcons.Actions.New" OnClick="OpenCreateTicketDialogAsync">
                    New ticket
                </MudButton>
            }
            else if (_isOperator)
            {
                <MudSelect T="bool" Label="Ticket view" @bind-Value="_showOnlyMyTickets" @bind-Value:after="RefreshBoard" Variant="Variant.Outlined" Margin="Margin.Dense" Style="width: 180px;">
                    <MudSelectItem T="bool" Value="@true">My tickets</MudSelectItem>
                    <MudSelectItem T="bool" Value="@false">All tickets</MudSelectItem>
                </MudSelect>
            }
        </MudStack>

        @if (!string.IsNullOrWhiteSpace(_loadErrorMessage))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.subtitle1">Tickets could not be loaded</MudText>
                    <MudText Typo="Typo.body2">@_loadErrorMessage</MudText>
                    <MudButton Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Outlined.Refresh" OnClick="LoadTicketsAsync">Try again</MudButton>
                </MudStack>
            </MudAlert>
        }
        else
        {
            <div class="kanban-board">
                <MudDropContainer T="TicketPOCO" @ref="_dropContainer" Items="@_visibleTickets"
                                  ItemsSelector="@((ticket, dropzone) => ticket.StatusId.ToString(CultureInfo.InvariantCulture) == dropzone)"
                                  ItemDropped="HandleTicketDroppedAsync"
                                  ItemDisabled="IsTicketDisabled"
                                  ApplyDropClassesOnDragStarted="false"
                                  Class="mud-width-full kanban-drop-container">
                    <ChildContent>
                        <MudGrid Spacing="2" Class="kanban-grid">
                            @foreach (var status in TicketStatusOptions.All)
                            {
                                <MudItem xs="3" Class="d-flex kanban-column">
                                    <MudDropZone T="TicketPOCO"
                                                 Identifier="@status.Id.ToString(CultureInfo.InvariantCulture)"
                                                 CanDrop="@(_ => true)"
                                                 CanDropClass="@status.DropBorderClass"
                                                 Class="mud-paper mud-paper-rounded mud-paper-outlined pa-3 flex-grow-1 border-2 border-solid mud-border-lines-default kanban-drop-zone">
                                        <div class="kanban-column-header">
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
                                                <MudText Typo="Typo.h6" Color="@status.Color">@status.Name</MudText>
                                                <MudText Typo="Typo.caption">@GetTicketCountText(status.Id)</MudText>
                                            </MudStack>
                                            <MudDivider Class="mb-1" />
                                        </div>

                                        @if (!_visibleTickets.Any(ticket => ticket.StatusId == status.Id))
                                        {
                                            <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary" Class="pa-4">No tickets</MudText>
                                        }
                                    </MudDropZone>
                                </MudItem>
                            }
                        </MudGrid>
                    </ChildContent>
                    <ItemRenderer Context="ticket">
                        <MudCard Outlined="true" Class="mt-3" Style="cursor: pointer;" @onclick="@(() => OpenTicketDialogAsync(ticket))">
                            <MudCardContent>
                                <MudStack Spacing="2">
                                    <MudText Typo="Typo.subtitle2">#@ticket.TicketNumber</MudText>
                                    <MudText Typo="Typo.subtitle1"><strong>@ticket.Title</strong></MudText>
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                        <MudChip T="string" Color="@TicketPriorityColorMapper.GetColor(ticket.PriorityImpact)" Variant="Variant.Outlined" Size="Size.Small" Class="ml-0">@ticket.PriorityDisplayName</MudChip>
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                            @if (_updatingTicketIds.Contains(ticket.Id))
                                            {
                                                <MudProgressCircular Size="Size.Small" Color="Color.Primary" Indeterminate="true" />
                                            }
                                            <MudText Typo="Typo.caption">@ticket.UpdatedAt.ToString("dd MMM yyyy, HH:mm", CultureInfo.InvariantCulture)</MudText>
                                        </MudStack>
                                    </MudStack>
                                </MudStack>
                            </MudCardContent>
                        </MudCard>
                    </ItemRenderer>
                </MudDropContainer>
            </div>
        }
    </MudStack>
</MudContainer>

<style>
    .tickets-page {
        height: calc(100dvh - var(--mud-appbar-height));
        overflow: hidden;
    }

    .tickets-page-content {
        height: 100%;
        min-height: 0;
        overflow: hidden;
    }

    .kanban-board {
        display: flex;
        flex: 1 1 auto;
        min-height: 0;
        overflow: hidden;
    }

    .kanban-drop-container,
    .kanban-grid,
    .kanban-column {
        height: 100%;
        min-height: 0;
    }

    .kanban-grid {
        flex: 1 1 auto;
    }

    .kanban-drop-zone {
        height: 100%;
        min-height: 0;
        overflow-x: hidden;
        overflow-y: auto;
    }

    .kanban-column-header {
        position: sticky;
        top: 0;
        z-index: 1;
        background: var(--mud-palette-surface);
    }

    .blur-class {
        backdrop-filter: blur(10px);
    }
</style>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> _authenticationState { get; set; } = default!;

    private readonly HashSet<Guid> _updatingTicketIds = [];
    private readonly HashSet<Guid> _ticketIdsRemovedDuringLoad = [];
    private readonly Dictionary<Guid, TicketPOCO> _ticketsReceivedDuringLoad = [];
    private List<TicketPOCO> _tickets = [];
    private MudDropContainer<TicketPOCO>? _dropContainer;
    private HubConnection? _ticketHubConnection;
    private IDisposable? _ticketCreatedSubscription;
    private IDisposable? _ticketDeletedSubscription;
    private IDisposable? _ticketUpdatedSubscription;
    private string _accessToken = string.Empty;
    private string _currentUserEmail = string.Empty;
    private string _currentUserFirstName = string.Empty;
    private string _currentUserLastName = string.Empty;
    private Guid _currentUserId;
    private string? _loadErrorMessage;
    private bool _isAdministrator;
    private bool _isCustomer;
    private bool _isLoading = true;
    private bool _isOperator;
    private bool _showOnlyMyTickets;

    private IEnumerable<TicketPOCO> _visibleTickets => _isOperator && _showOnlyMyTickets
        ? _tickets.Where(ticket => ticket.OperatorId == _currentUserId)
        : _tickets;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var authenticationState = await _authenticationState;
        _currentUserId = Guid.Parse(authenticationState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value);
        _currentUserEmail = authenticationState.User.FindFirst(System.Security.Claims.ClaimTypes.Email)!.Value;
        _currentUserFirstName = authenticationState.User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)!.Value;
        _currentUserLastName = authenticationState.User.FindFirst(System.Security.Claims.ClaimTypes.Surname)!.Value;
        _isAdministrator = authenticationState.User.IsInRole(nameof(AppUserType.Administrator));
        _isCustomer = authenticationState.User.IsInRole(nameof(AppUserType.Customer));
        _isOperator = authenticationState.User.IsInRole(nameof(AppUserType.Operator));
        _showOnlyMyTickets = _isOperator;

        _accessToken = authenticationState.User.FindFirst(TicketSystemClaimTypes.ApiAccessToken)!.Value;
        await ConnectToTicketHubAsync(_accessToken);
        await LoadTicketsAsync();
        StateHasChanged();
    }

    private async Task ConnectToTicketHubAsync(string accessToken)
    {
        var realtimeBaseUrl = Configuration["Realtime:BaseUrl"]
            ?? throw new InvalidOperationException("The 'Realtime:BaseUrl' configuration value is required.");

        _ticketHubConnection = new HubConnectionBuilder()
            .WithUrl($"{realtimeBaseUrl.TrimEnd('/')}{RealtimeHubRoutes.Tickets}", options =>
            {
                options.AccessTokenProvider = () => Task.FromResult<string?>(accessToken);
            })
            .WithAutomaticReconnect()
            .Build();
        _ticketCreatedSubscription = _ticketHubConnection.On<Guid>(TicketRealtimeEvents.Created, HandleTicketCreatedAsync);
        _ticketUpdatedSubscription = _ticketHubConnection.On<Guid>(TicketRealtimeEvents.Updated, HandleTicketUpdatedAsync);
        _ticketDeletedSubscription = _ticketHubConnection.On<Guid>(TicketRealtimeEvents.Deleted, HandleTicketDeletedAsync);
        _ticketHubConnection.Reconnected += HandleTicketHubReconnectedAsync;

        for (var attempt = 1; attempt <= 3; attempt++)
        {
            try
            {
                await _ticketHubConnection.StartAsync();
                return;
            }
            catch (Exception exception) when (exception is HttpRequestException or InvalidOperationException or TaskCanceledException)
            {
                if (attempt == 3)
                {
                    Snackbar.Add("Live ticket updates are currently unavailable.", Severity.Warning);
                    return;
                }

                await Task.Delay(TimeSpan.FromSeconds(1));
            }
        }
    }

    private async Task HandleTicketCreatedAsync(Guid ticketId)
    {
        await ReloadTicketAsync(ticketId, false, "A new ticket could not be loaded.");
    }

    private async Task HandleTicketUpdatedAsync(Guid ticketId)
    {
        await ReloadTicketAsync(ticketId, true, "An updated ticket could not be loaded.");
    }

    private async Task HandleTicketDeletedAsync(Guid ticketId)
    {
        await InvokeAsync(() => RemoveTicket(ticketId));
    }

    private async Task ReloadTicketAsync(Guid ticketId, bool removeWhenNotFound, string errorMessage)
    {
        try
        {
            using var response = await ApiClient.GetAsync($"api/tickets/{ticketId}");
            if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                if (removeWhenNotFound)
                {
                    await InvokeAsync(() => RemoveTicket(ticketId));
                }

                return;
            }

            response.EnsureSuccessStatusCode();
            var ticket = await response.Content.ReadFromJsonAsync<TicketPOCO>()
                ?? throw new JsonException("The API returned an empty ticket response.");

            await InvokeAsync(() =>
            {
                if (_isLoading)
                {
                    _ticketIdsRemovedDuringLoad.Remove(ticket.Id);
                    _ticketsReceivedDuringLoad[ticket.Id] = ticket;
                }

                UpsertTicket(ticket);
                RefreshBoard();
            });
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or TaskCanceledException)
        {
            await InvokeAsync(() => Snackbar.Add(errorMessage, Severity.Warning));
        }
    }

    private async Task HandleTicketHubReconnectedAsync(string? connectionId)
    {
        await InvokeAsync(async () =>
        {
            await LoadTicketsAsync();
            RefreshBoard();
        });
    }

    private async Task LoadTicketsAsync()
    {
        using var loadingScope = LoadingState.BeginLoading();
        _isLoading = true;
        _loadErrorMessage = null;

        try
        {
            using var response = await ApiClient.GetAsync("api/tickets");

            if (!response.IsSuccessStatusCode)
            {
                _loadErrorMessage = "The API returned an error while loading tickets.";
                return;
            }

            _tickets = await response.Content.ReadFromJsonAsync<List<TicketPOCO>>() ?? [];
            foreach (var ticket in _ticketsReceivedDuringLoad.Values)
            {
                UpsertTicket(ticket);
            }

            _tickets.RemoveAll(ticket => _ticketIdsRemovedDuringLoad.Contains(ticket.Id));
            _ticketsReceivedDuringLoad.Clear();
            _ticketIdsRemovedDuringLoad.Clear();
        }
        catch (HttpRequestException)
        {
            _loadErrorMessage = "The API is currently unavailable. Please try again later.";
        }
        catch (JsonException)
        {
            _loadErrorMessage = "The API returned an invalid tickets response.";
        }
        catch (TaskCanceledException)
        {
            _loadErrorMessage = "The tickets request timed out. Please try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleTicketDroppedAsync(MudItemDropInfo<TicketPOCO> dropInfo)
    {
        var ticket = dropInfo.Item;
        var newStatusId = short.Parse(dropInfo.DropzoneIdentifier, CultureInfo.InvariantCulture);

        if (ticket.StatusId == newStatusId || !CanEditTicket(ticket))
        {
            return;
        }

        var previousStatusId = ticket.StatusId;
        var previousClosedAt = ticket.ClosedAt;

        ticket.StatusId = newStatusId;
        ticket.ClosedAt = newStatusId == TicketStatusOptions.ClosedId ? DateTimeOffset.Now : null;
        _updatingTicketIds.Add(ticket.Id);
        RefreshBoard();

        try
        {
            using var response = await ApiClient.PutAsJsonAsync($"api/tickets/{ticket.Id}", ticket);

            if (!response.IsSuccessStatusCode || !await response.Content.ReadFromJsonAsync<bool>())
            {
                RevertTicket(ticket, previousStatusId, previousClosedAt);
                Snackbar.Add("Ticket status could not be updated.", Severity.Error);
            }
        }
        catch (HttpRequestException)
        {
            RevertTicket(ticket, previousStatusId, previousClosedAt);
            Snackbar.Add("The API is currently unavailable.", Severity.Error);
        }
        catch (JsonException)
        {
            RevertTicket(ticket, previousStatusId, previousClosedAt);
            Snackbar.Add("The API returned an invalid ticket response.", Severity.Error);
        }
        catch (TaskCanceledException)
        {
            RevertTicket(ticket, previousStatusId, previousClosedAt);
            Snackbar.Add("The ticket update timed out.", Severity.Error);
        }
        finally
        {
            _updatingTicketIds.Remove(ticket.Id);
            RefreshBoard();
        }
    }

    private async Task OpenCreateTicketDialogAsync()
    {
        var options = new DialogOptions
        {
            CloseButton = true,
            FullWidth = true,
            MaxWidth = MaxWidth.Small,
            BackdropClick = false
        };
        var dialog = await DialogService.ShowAsync<CreateTicketDialog>("New ticket", options);
        var result = await dialog.Result;

        if (result is null || result.Canceled || result.Data is not TicketPOCO ticket)
        {
            return;
        }

        UpsertTicket(ticket);
        RefreshBoard();
    }

    private async Task OpenTicketDialogAsync(TicketPOCO ticket)
    {
        var parameters = new DialogParameters
        {
            [nameof(TicketDialog._ticket)] = ticket,
            [nameof(TicketDialog._isReadOnly)] = !CanEditTicket(ticket),
            [nameof(TicketDialog._canAssign)] = _isAdministrator,
            [nameof(TicketDialog._canDelete)] = _isAdministrator,
            [nameof(TicketDialog._isOperator)] = _isOperator,
            [nameof(TicketDialog._currentUserId)] = _currentUserId,
            [nameof(TicketDialog._currentUserEmail)] = _currentUserEmail,
            [nameof(TicketDialog._currentUserFirstName)] = _currentUserFirstName,
            [nameof(TicketDialog._currentUserLastName)] = _currentUserLastName,
            [nameof(TicketDialog._accessToken)] = _accessToken
        };
        var options = new DialogOptions
        {
            CloseButton = true,
            FullWidth = true,
            MaxWidth = MaxWidth.Medium,
            BackdropClick = false,
            BackgroundClass = "blur-class"
        };

        var dialog = await DialogService.ShowAsync<TicketDialog>($"Ticket #{ticket.TicketNumber}", parameters, options);
        var result = await dialog.Result;

        if (result is null || result.Canceled)
        {
            return;
        }

        if (result.Data is TicketPOCO updatedTicket)
        {
            UpsertTicket(updatedTicket);
        }
        else if (result.Data is Guid deletedTicketId)
        {
            _tickets.RemoveAll(existingTicket => existingTicket.Id == deletedTicketId);
        }

        RefreshBoard();
    }

    private bool CanEditTicket(TicketPOCO ticket)
    {
        return _isAdministrator || _isOperator && ticket.OperatorId == _currentUserId;
    }

    private bool IsTicketDisabled(TicketPOCO ticket)
    {
        return _updatingTicketIds.Contains(ticket.Id) || !CanEditTicket(ticket);
    }

    private void RevertTicket(TicketPOCO ticket, short previousStatusId, DateTimeOffset? previousClosedAt)
    {
        ticket.StatusId = previousStatusId;
        ticket.ClosedAt = previousClosedAt;
    }

    private void RefreshBoard()
    {
        _tickets = [.. _tickets];
        _dropContainer?.Refresh();
        StateHasChanged();
    }

    private void UpsertTicket(TicketPOCO ticket)
    {
        var ticketIndex = _tickets.FindIndex(existingTicket => existingTicket.Id == ticket.Id);
        if (ticketIndex == -1)
        {
            _tickets.Insert(0, ticket);
            return;
        }

        _tickets[ticketIndex] = ticket;
    }

    private void RemoveTicket(Guid ticketId)
    {
        if (_isLoading)
        {
            _ticketsReceivedDuringLoad.Remove(ticketId);
            _ticketIdsRemovedDuringLoad.Add(ticketId);
        }

        _tickets.RemoveAll(ticket => ticket.Id == ticketId);
        RefreshBoard();
    }

    private string GetTicketCountText(short statusId)
    {
        var ticketCount = _visibleTickets.Count(ticket => ticket.StatusId == statusId);
        return ticketCount == 1 ? "1 ticket" : $"{ticketCount} tickets";
    }

    public async ValueTask DisposeAsync()
    {
        _ticketCreatedSubscription?.Dispose();
        _ticketUpdatedSubscription?.Dispose();
        _ticketDeletedSubscription?.Dispose();
        if (_ticketHubConnection is not null)
        {
            _ticketHubConnection.Reconnected -= HandleTicketHubReconnectedAsync;
            await _ticketHubConnection.DisposeAsync();
        }
    }
}

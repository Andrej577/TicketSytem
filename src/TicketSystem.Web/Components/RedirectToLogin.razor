@inject NavigationManager Navigation

@code {
    [CascadingParameter]
    private Task<AuthenticationState> _authenticationState { get; set; } = default!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var authenticationState = await _authenticationState;
        if (authenticationState.User.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo("/access-denied", true);
            return;
        }

        var returnUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString($"/{returnUrl}")}", true);
    }
}
